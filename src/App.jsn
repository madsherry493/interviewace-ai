function Categories() {
  const [activeId, setActiveId] = useState(CATEGORIES[0].id);
  const active = useMemo(() => CATEGORIES.find((c) => c.id === activeId), [activeId]);

  const onKeyDown = (e) => {
    const i = CATEGORIES.findIndex((c) => c.id === activeId);
    let next = null;
    if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % CATEGORIES.length;
    if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + CATEGORIES.length) % CATEGORIES.length;
    if (next !== null) {
      e.preventDefault();
      setActiveId(CATEGORIES[next].id);
      document.getElementById(`tab-${CATEGORIES[next].id}`)?.focus();
    }
  };

  return (
    <section id="questions" className="section section-alt">
      <div className="container">
        <header className="section-head">
          <h2>Popular job categories</h2>
          <p>Pick a role to see common questions and how to approach them.</p>
        </header>

        <div className="tabs" role="tablist" aria-label="Job categories" onKeyDown={onKeyDown}>
          {CATEGORIES.map(({ id, name, icon: Icon }) => (
            <button
              key={id}
              id={`tab-${id}`}
              role="tab"
              type="button"
              aria-selected={activeId === id}
              aria-controls="category-panel"
              tabIndex={activeId === id ? 0 : -1}
              className={`tab ${activeId === id ? "is-active" : ""}`}
              onClick={() => setActiveId(id)}
            >
              <Icon size={18} aria-hidden="true" />
              {name}
            </button>
          ))}
        </div>

        <div
          id="category-panel"
          role="tabpanel"
          aria-labelledby={`tab-${active.id}`}
          className="panel card"
          key={active.id}
        >
          <div className="panel-head">
            <h3>{active.name} interview questions</h3>
            <p>{active.blurb}</p>
          </div>
          <ul className="q-list">
            {active.questions.map(({ q, tip }) => (
              <li key={q}>
                <details className="q-item">
                  <summary>
                    <span>{q}</span>
                    <ChevronDown size={18} aria-hidden="true" />
                  </summary>
                  <p>
                    <strong>How to approach it: </strong>
                    {tip}
                  </p>
                </details>
              </li>
            ))}
          </ul>
          <a href="#practice" className="btn btn-ghost panel-cta">
            Practice an answer <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  );
}

function Practice() {
  const [showExample, setShowExample] = useState(true);
  const [draft, setDraft] = useState("");
  const [checks, setChecks] = useState(CHECKLIST.map(() => false));

  const words = draft.trim() ? draft.trim().split(/\s+/).length : 0;
  const seconds = Math.round((words / 130) * 60);
  const timeLabel = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
  const score = Math.round((checks.filter(Boolean).length / CHECKLIST.length) * 100);

  const toggle = (i) => setChecks((prev) => prev.map((v, idx) => (idx === i ? !v : v)));
  const reset = () => {
    setDraft("");
    setChecks(CHECKLIST.map(() => false));
  };

  return (
    <section id="practice" className="section">
      <div className="container">
        <header className="section-head">
          <h2>Try a sample question</h2>
          <p>Read the example, write your own answer, then score yourself with the checklist.</p>
        </header>

        <div className="practice-grid">
          <article className="card example">
            <p className="badge badge-soft">Behavioral · Most common</p>
            <h3 className="big-q">"Tell me about yourself"</h3>
            <p className="muted">
              Use a simple Present, Past, Future structure and keep it to about a minute and a half.
            </p>

            <button
              type="button"
              className="btn btn-ghost btn-sm"
              onClick={() => setShowExample((s) => !s)}
              aria-expanded={showExample}
              aria-controls="example-answer"
            >
              {showExample ? "Hide example answer" : "Show example answer"}
            </button>

            {showExample && (
              <div id="example-answer" className="answer">
                {EXAMPLE_ANSWER.map(({ label, text }) => (
                  <div className="answer-step" key={label}>
                    <span className="answer-label">{label}</span>
                    <p>{text}</p>
                  </div>
                ))}
              </div>
            )}
            <p className="note">
              This is a sample. Replace the details with your own experience so your answer sounds
              like you.
            </p>
          </article>

          <article className="card workspace">
            <h3>Your practice answer</h3>
            <label htmlFor="draft" className="sr-only">Write your answer</label>
            <textarea
              id="draft"
              rows={7}
              value={draft}
              onChange={(e) => setDraft(e.target.value)}
              placeholder="Type or speak your answer here, then edit it until it feels natural."
            />
            <div className="stats">
              <span>{words} words</span>
              <span><Clock size={14} aria-hidden="true" /> About {timeLabel} spoken</span>
            </div>

            <fieldset className="checklist">
              <legend>Self-check</legend>
              {CHECKLIST.map((item, i) => (
                <label key={item} className={`check ${checks[i] ? "is-checked" : ""}`}>
                  <input type="checkbox" checked={checks[i]} onChange={() => toggle(i)} />
                  <span className="check-box" aria-hidden="true">
                    {checks[i] && <Check size={14} />}
                  </span>
                  {item}
                </label>
              ))}
            </fieldset>

            <div className="score-row">
              <ScoreRing value={score} size={84} label="Your self-check score" />
              <div>
                <p className="score-title">Your self-check score</p>
                <p className="muted small">
                  Based on the checklist you complete. It reflects your own review.
                </p>
              </div>
              <button type="button" className="btn btn-ghost btn-sm" onClick={reset}>
                Reset
              </button>
            </div>
          </article>
        </div>
      </div>
    </section>
  );
}

function Guides() {
  const [openIndex, setOpenIndex] = useState(0);
  return (
    <section id="guides" className="section section-alt">
      <div className="container guides">
        <header className="section-head left">
          <h2>Career guides</h2>
          <p>Quick checklists for every stage of the interview process.</p>
        </header>
        <div className="accordion">
          {GUIDES.map((g, i) => {
            const open = openIndex === i;
            return (
              <div className={`acc-item card ${open ? "is-open" : ""}`} key={g.title}>
                <h3>
                  <button
                    type="button"
                    className="acc-btn"
                    aria-expanded={open}
                    aria-controls={`guide-${i}`}
                    onClick={() => setOpenIndex(open ? -1 : i)}
                  >
                    {g.title}
                    <ChevronDown size={20} aria-hidden="true" />
                  </button>
                </h3>
                <div id={`guide-${i}`} className="acc-panel" hidden={!open}>
                  <ul>
                    {g.points.map((p) => (
                      <li key={p}>
                        <Check size={16} aria-hidden="true" />
                        {p}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );
}

